# Copy to .env and fill in locally. Never commit the completed file.
RESEND_API_KEY=your-resend-api-key
STORE_OTP_FROM_EMAIL=Re Market <no-reply@your-verified-domain.com>
STORE_OTP_HMAC_SECRET=random-secret-of-at-least-32-characters
# Enable demo access only when explicitly testing allowlisted accounts.
STORE_DEMO_MODE=false
STORE_DEMO_USER_IDS=
STORE_DEMO_EMAIL_TO=
STORE_ACTION_ALLOWED_ORIGINS=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
